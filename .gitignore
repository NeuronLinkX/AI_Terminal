# ─── Secrets and credentials — never commit ────────────────────────────────────────────────────
# API keys live in the environment (OPENAI_API_KEY / OPENAI_ADMIN_KEY) or the macOS Keychain, never in this folder.
.env
.env.*
!.env.example
*.local
.npmrc
.netrc
.pypirc
.aws/
.ssh/
.gnupg/
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.p8
*.pfx
*.gpg
*.keychain
*.keychain-db
*.mobileprovision
*.provisionprofile
credentials*.json
secrets.json
secrets.*.json
service-account*.json
*.token

# ─── Data that belongs on the user's machine (the app keeps these under ~/Library/Application Support) ───
# settings, usage counters, audit log, session history, project rules, file backups, shell histories
/settings.json
/usage*.jsonl
/audit*.jsonl
/history/
/backups/
/projects.json
.zsh_history
.zsh_sessions/
.bash_history
.lesshst
.viminfo
.netrwhist

# ─── Local tooling / editor / agent state ──────────────────────────────────────────────────────
.claude/
CLAUDE.local.md
.cursor/
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Dependencies and build output ─────────────────────────────────────────────────────────────
node_modules/
dist/
build/native/
src/build-info.json
coverage/
*.dmg
*.tgz

# ─── Test, capture and scratch output ──────────────────────────────────────────────────────────
e2e-out/
test/visual/__actual__/
tmp/
.tmp/
*.log
npm-debug.log*
docs/*.partial.json

# ─── Local model files (large, downloaded by the user) ─────────────────────────────────────────
*.gguf
*.safetensors

# ─── OS files ──────────────────────────────────────────────────────────────────────────────────
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
site/downloads/
*.outbox.log
