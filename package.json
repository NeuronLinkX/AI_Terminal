{
  "name": "ai-terminal",
  "productName": "AI Terminal",
  "version": "0.1.0",
  "description": "AI-driven terminal: real PTY shell + natural-language agent",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:native": "node scripts/build-native.js",
    "e2e:features": "node scripts/e2e-features.js",
    "i18n:check": "node scripts/i18n-check.js",
    "visual": "node scripts/visual.js",
    "visual:update": "node scripts/visual.js --update",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper || true",
    "e2e": "node scripts/e2e.js",
    "dist": "node scripts/build.js",
    "dist:arm64": "node scripts/build.js --arch=arm64",
    "dist:x64": "node scripts/build.js --arch=x64",
    "dist:universal": "node scripts/build.js --arch=universal"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "author": "AI Terminal",
  "build": {
    "appId": "local.aiterminal.app",
    "productName": "AI Terminal",
    "copyright": "MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/@xterm/xterm/lib/**",
      "node_modules/@xterm/xterm/css/**",
      "node_modules/@xterm/addon-fit/lib/**",
      "node_modules/@xterm/addon-search/lib/**",
      "node_modules/@xterm/addon-web-links/lib/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/main/shell-integration/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.developer-tools"
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "AI Terminal ${version}",
      "icon": "build/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NeuronLinkX/AI_Terminal.git"
  },
  "homepage": "https://github.com/NeuronLinkX/AI_Terminal"
}
